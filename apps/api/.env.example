# API environment variables
# Copy to .env and fill in values before running.

# Required: PostgreSQL connection string
# To spin up a temporary Postgres for local dev without Docker Compose:
#   docker run -d --rm -p 5432:5432 -e POSTGRES_DB=recipes -e POSTGRES_PASSWORD=recipes postgres:16
#   DATABASE_URL=postgres://postgres:recipes@localhost:5432/recipes
DATABASE_URL=postgres://user:password@localhost:5432/recipes

# Optional: listening port (default: 3001)
PORT=3001

# Optional: dev CORS origin (default: http://localhost:5173 when NODE_ENV != production)
CORS_ORIGIN=http://localhost:5173

# Optional: absolute path to the built web app (enables SPA static serving in production)
# WEB_DIST_DIR=/app/web/dist
