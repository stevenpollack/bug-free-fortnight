{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:db:up": "docker run -d --rm -p 5432:5432 -e POSTGRES_USER=recipes -e POSTGRES_DB=recipes -e POSTGRES_PASSWORD=recipes postgres:17.5-alpine",
    "dev": "bun run --watch src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.91.1",
    "@hono/zod-validator": "0.7.6",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.15",
    "parse-ingredient": "2.2.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.9",
    "uuidv7": "1.2.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3"
  }
}
