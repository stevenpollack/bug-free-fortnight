# Postgres
POSTGRES_USER=recipes
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=recipes

# App (API + web SPA, port 3001)
APP_PORT=3001
# Optional: enables AI recipe generation and meal plan import
# ANTHROPIC_API_KEY=sk-ant-...

# MCP server (port 3002)
MCP_PORT=3002
# Set a strong secret to require Bearer token auth; leave empty to disable auth
MCP_BEARER_TOKEN=change-me-please

# Deployment (used by scripts/deploy.sh / bun run deploy)
DEPLOY_HOST=192.168.2.150        # server IP or Tailscale hostname
DEPLOY_USER=youruser             # SSH username on the server
DEPLOY_PATH=/home/youruser/family-recipes  # repo root on the server
# DEPLOY_SSH_KEY=                # raw private key — omit to use SSH agent

# Logging
# LOG_LEVEL=info        # trace|debug|info|warn|error|fatal
# LOG_PRETTY=1          # force pino-pretty in production
# DEBUG_SQL=1           # log every Drizzle/postgres query (verbose)
